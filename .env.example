# Set SPRING_PROFILES_ACTIVE to local or prod when running the application.
SPRING_PROFILES_ACTIVE=

# Required JWT signing key (standard Base64 encoding of at least 32 random bytes).
# Production supplies this through the GitHub production Environment Secret of the same name.
JWT_SECRET_BASE64=

# Required for the local profile.
LOCAL_DB_URL=
LOCAL_DB_USERNAME=
LOCAL_DB_PASSWORD=

# Required for the prod profile.
PROD_DB_URL=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# Generated on EC2 only; never copy credentials into GitHub or this file.
MYSQL_ROOT_PASSWORD=

# Per-release image.env, generated by the deployment script.
APP_IMAGE=

# Optional overrides; multipart defaults are 10MB per file and 12MB per request.
SPRING_APPLICATION_NAME=
MULTIPART_MAX_FILE_SIZE=
MULTIPART_MAX_REQUEST_SIZE=

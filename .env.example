# Set SPRING_PROFILES_ACTIVE to local or prod when running the application.
SPRING_PROFILES_ACTIVE=local

# Required for the local profile.
LOCAL_DB_URL=
LOCAL_DB_USERNAME=
LOCAL_DB_PASSWORD=

# Required for the prod profile.
PROD_DB_URL=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# Optional override names: SPRING_APPLICATION_NAME,
# MULTIPART_MAX_FILE_SIZE, MULTIPART_MAX_REQUEST_SIZE.
# Leave them unset to use danditon, 10MB, and 10MB.
